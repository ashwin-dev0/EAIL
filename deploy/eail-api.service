[Unit]
Description=EAIL local API
After=network.target ollama.service
[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/eail
ExecStart=/home/ubuntu/eail/venv/bin/python -m uvicorn src.api:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/eail/data /home/ubuntu/eail/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
[Install]
WantedBy=multi-user.target
