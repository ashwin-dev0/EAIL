# This file is an example. Copy to .env and chmod 600.
# SQLite is an isolated demo default; use a dedicated ShaktiDB database for deployment.
# DATABASE_URL=postgresql://eail_runtime:URL_ENCODED_PASSWORD@127.0.0.1:15234/eaildb
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
JUDGE_MODEL=qwen2.5:1.5b
OLLAMA_KEEP_ALIVE=5m
# On a low-memory host unload generator before independent judging.
UNLOAD_BEFORE_JUDGE=true
EMBEDDING_BACKEND=minilm
# Default model location: ./models/all-MiniLM-L6-v2
TOP_K=10
MIN_SIMILARITY_SCORE=0.30
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_BYTES=20971520
MAX_EXTRACTED_CHARS=2000000
MAX_SECTIONS=300
MAX_ROWS=10000
EXTRACTION_TIMEOUT=120
EXTRACTION_MEMORY_MB=2048
OCR_TIMEOUT=30
OLLAMA_TIMEOUT=180
MAX_CONTEXT_CHARS=9000
QUERY_TIMEOUT=420
WATCHER_INTERVAL=15

# Optional offline verification of RS256 tokens issued by your private enterprise IdP.
# OIDC_ISSUER=https://identity.internal.example/realms/eail
# OIDC_AUDIENCE=eail-api
# OIDC_PUBLIC_KEY_FILE=/etc/eail/oidc-public.pem
# OIDC_ONLY=true

# Source integration; secrets stay in .env or enterprise secret injection.
# CONNECTORS_FILE=/home/ubuntu/eail/config/connectors.json
SOURCE_SYNC_INTERVAL=900
# ZOHO_CLIENT_ID=...
# ZOHO_CLIENT_SECRET=...
# ZOHO_BOOKS_REFRESH_TOKEN=...
# ZOHO_CRM_REFRESH_TOKEN=...
# ZOHO_ANALYTICS_REFRESH_TOKEN=...
# TALLY_URL=http://127.0.0.1:9000
# TALLY_COMPANY=Exact loaded company name
# SOURCE_DATABASE_URL=postgresql+psycopg://readonly_user:URL_ENCODED_PASSWORD@db.internal:5432/business?sslmode=verify-full

# ZOHO_TOKEN_CACHE_KEY=GENERATE_WITH_scripts/generate_connector_key.py
